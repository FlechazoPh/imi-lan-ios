build/
IMILAN/Engine/vendor/
*.ipa
*.xcarchive
*.app
*.dSYM

# 签名与证书（绝不入库，见 docs/SIGNING.md §4）
*.p12
*.mobileprovision
ExportOptions.plist
*.cer

# go2rtc 源码与上游补丁（本机取，版本以脚本打印的 commit/tag 为准）
build/go2rtc-src/
build/patches/
build/imi-lan-upstream/

# 用户令牌与日志（含小米登录令牌，绝不入库、不发聊天）
