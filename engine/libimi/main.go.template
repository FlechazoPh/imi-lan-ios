// ---- 状态机（单次启动 + 幂等停止；多次启停见 §C，未验证） ----
var (
	mu       sync.Mutex
	running  bool
	done     chan struct{} // IMIStopEngine 关闭它；runEngine 的阻塞等待只等它。
	startErr string        // 最近一次启动失败的原因（写日志 + 进 IMIEngineStatus）。
)

// goString 把 C 字符串安全转 Go string；nil 返回 ""。
func goString(s *C.char) string {
	if s == nil {
		return ""
	}
	return C.GoString(s)
}

// statusJSON 生成 IMIEngineStatus 返回的 JSON；调用方负责 C.free。
func statusJSON() *C.char {
	mu.Lock()
	defer mu.Unlock()
	b, _ := json.Marshal(map[string]interface{}{
		"running": running,
		"error":   startErr,
		// 注意：不要在这里回显 configPath/logPath 的完整路径（日志里有用户名）。
	})
	return C.CString(string(b))
}

