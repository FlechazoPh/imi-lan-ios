//export IMIStartEngine
func IMIStartEngine(configPath *C.char, logPath *C.char) C.int {
	cfg := goString(configPath)
	log := goString(logPath)
	if cfg == "" || log == "" {
		mu.Lock()
		startErr = "IMIStartEngine: configPath/logPath must not be empty"
		mu.Unlock()
		return 1
	}
	mu.Lock()
	if running {
		mu.Unlock()
		return 1 // 已在运行；不要重复启动（§C：多次启停未验证）。
	}
	running = true
	startErr = ""
	done = make(chan struct{})
	mu.Unlock()

	// TODO (MacBook 上填)：把 runEngine(cfg, log) 在 goroutine 里跑起来。
	// 启动是异步的：返回 0 只表示“已接受启动请求”，真正的运行状态
	// 由 IMIEngineStatus 查询；启动失败的原因写进 log 文件 + startErr。
	// 注意：不要在这里阻塞等 runEngine 跑完——它要一直跑到 IMIStopEngine。
	return -1 // 模板占位：runEngine 未填好之前一律返回 -1，不要假装启动成功。
}

//export IMIStopEngine
func IMIStopEngine() C.int {
	mu.Lock()
	if !running {
		mu.Unlock()
		return 0 // 幂等：未在运行也返回 0。
	}
	close(done)
	running = false
	mu.Unlock()
	// TODO (MacBook 上验证)：上面只关了 done chan。HTTP/RTSP/WebRTC
	// 监听是否真停、端口是否释放、流注册表是否清理，都要实测后才能写。
	// 实测前不要在文档里写“已释放”。
	return 0
}

//export IMIEngineStatus
func IMIEngineStatus() *C.char {
	// 返回的 C 字符串由调用方（Swift 侧）负责 C.free，
	// 不要返回指向 Go 内存的指针。
	// 模板占位：先返回固定 JSON，真实实现按运行状态生成（见 statusJSON）。
	_ = unsafe.Pointer(nil)
	return statusJSON()
}

func main() {
	// c-archive 模式下 main() 不会被调用，但 package main 必须有 main 函数。
	// 不要在这里启动引擎——启动只由 IMIStartEngine 触发。
}
